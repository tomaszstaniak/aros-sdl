-			ModifyIDCMP(data->win, IDCMP_CLOSEWINDOW | IDCMP_RAWKEY | IDCMP_MOUSEMOVE | (SDL_GetRelativeMouseMode() ? IDCMP_DELTAMOVE : 0) | IDCMP_MOUSEBUTTONS | IDCMP_REFRESHWINDOW | IDCMP_ACTIVEWINDOW | IDCMP_INACTIVEWINDOW | IDCMP_CHANGEWINDOW | IDCMP_GADGETUP | IDCMP_MENUPICK);
+			ModifyIDCMP(data->win, IDCMP_CLOSEWINDOW | IDCMP_RAWKEY | IDCMP_MOUSEMOVE | (SDL_GetRelativeMouseMode() ? IDCMP_DELTAMOVE : 0) | IDCMP_MOUSEBUTTONS | IDCMP_REFRESHWINDOW | IDCMP_ACTIVEWINDOW | IDCMP_INACTIVEWINDOW | IDCMP_CHANGEWINDOW | IDCMP_GADGETUP | IDCMP_MENUPICK | IDCMP_MENUVERIFY);
 
 			data->curr_x = data->win->LeftEdge;
 			data->curr_y = data->win->TopEdge;
 			data->curr_w = data->win->Width;
 			data->curr_h = data->win->Height;
+
+			{
+				SDL_PropertiesID props = SDL_GetWindowProperties(window);
+				SDL_SetPointerProperty(props, SDL_PROP_WINDOW_AROS_WINDOW_POINTER, data->win);
+				SDL_SetNumberProperty(props, SDL_PROP_WINDOW_AROS_MENUPICK_EVENT_NUMBER, AROS_MenuPickEventType());
+			}
 
 			/* WA_AutoAdjust shrinks a window that does not fit on the screen
 			   (an 800x600 inner area on an 800x600 screen, with its borders
diff -ru a/src/video/aros/SDL_aroswindow.h b/src/video/aros/SDL_aroswindow.h
--- a/src/video/aros/SDL_aroswindow.h	2026-11-16 14:49:04
+++ b/src/video/aros/SDL_aroswindow.h	2026-11-16 14:49:04
@@ -86,6 +86,7 @@
 	BYTE winflags;
 	
 	APTR menuvisualinfo;
+	/* program-installed menu strip support, see SDL_aroswindow.c */
 	struct Menu *menu;
 	BOOL menuactive;
 	
@@ -129,5 +130,24 @@
 extern void AROS_OpenWindows(SDL_VideoDevice *_this);
 extern void AROS_RecreateWindow(SDL_VideoDevice *_this, SDL_Window * window);
 extern void AROS_WindowToFront(struct Window *win);
+
+/* AROS window properties for programs that use the Intuition window directly:
+ *  SDL_PROP_WINDOW_AROS_WINDOW_POINTER       struct Window * of the SDL window (NULL when closed)
+ *  SDL_PROP_WINDOW_AROS_MENUPICK_EVENT_NUMBER SDL event type sent for picks in a menu strip the
+ *                                            program set with SetMenuStrip (user.code = the
+ *                                            Intuition menu number of one selected item, or
+ *                                            MENUNULL once when the menu closed without a choice)
+ *  SDL_PROP_WINDOW_AROS_MENUVERIFY_CALLBACK_POINTER  void (*)(void *userdata, struct Window *),
+ *                                            set by the program; called on IDCMP_MENUVERIFY
+ *                                            before the menu shows, to update item flags
+ *                                            (it must not replace the strip)
+ *  SDL_PROP_WINDOW_AROS_MENUVERIFY_USERDATA_POINTER  passed to that callback
+ */
+#define SDL_PROP_WINDOW_AROS_WINDOW_POINTER                "SDL.window.aros.window"
+#define SDL_PROP_WINDOW_AROS_MENUPICK_EVENT_NUMBER         "SDL.window.aros.menupick_event"
+#define SDL_PROP_WINDOW_AROS_MENUVERIFY_CALLBACK_POINTER   "SDL.window.aros.menuverify_callback"
+#define SDL_PROP_WINDOW_AROS_MENUVERIFY_USERDATA_POINTER   "SDL.window.aros.menuverify_userdata"
+
+extern Uint32 AROS_MenuPickEventType(void);
 
 #endif /* _SDL_aroswindow_h */
