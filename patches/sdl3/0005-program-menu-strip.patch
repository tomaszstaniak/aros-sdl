Title: Let programs use their own Intuition menu strip
Repository: SDL 3.4.12 with contrib SDL3-3.4.12-aros.diff (contrib 142b3ff4)
Date: 2026-11-16
Author: aros-sdl project
Problem: SDL gives every AROS window its own GadTools menu ("Project", "Options") and offers no way to reach the Intuition window, so a program cannot show its commands in the native menu; menu picks are only handled for SDL's own menu.
Change: Window properties: SDL.window.aros.window (struct Window *), SDL.window.aros.menupick_event (an SDL event type, registered once). A program sets its strip with SetMenuStrip; picks in it arrive as that event, one per selected item, with the Intuition menu number in user.code, and a menu closed without a choice as one event with MENUNULL. IDCMP_MENUVERIFY calls SDL.window.aros.menuverify_callback(userdata, window) before the menu shows; it may change item flags, not the strip. Closing a window clears a program strip.
Scope: AROS (src/video/aros)
Upstream: candidate (aros-development-team/contrib); API names open for review
Verification: pending
Removal: when contrib has an equivalent interface
---
diff -ru a/src/video/aros/SDL_arosevents.c b/src/video/aros/SDL_arosevents.c
--- a/src/video/aros/SDL_arosevents.c	2026-11-16 14:49:04
+++ b/src/video/aros/SDL_arosevents.c	2026-11-16 14:49:04
@@ -511,6 +511,27 @@
 AROS_HandleMenu(SDL_VideoDevice *_this, struct IntuiMessage *m)
 {
     SDL_WindowData *data = (SDL_WindowData *)m->IDCMPWindow->UserData;
+    if (data->win && data->win->MenuStrip && data->win->MenuStrip != data->menu) {
+        /* The program's own strip: pass every selected item on; a menu
+           closed without a choice arrives as one event with MENUNULL. */
+        UWORD code = m->Code;
+        Uint32 type = AROS_MenuPickEventType();
+        bool first = true;
+        while (type != 0 && (code != MENUNULL || first)) {
+            first = false;
+            struct MenuItem *item = ItemAddress(data->win->MenuStrip, code);
+            SDL_Event event;
+            SDL_zero(event);
+            event.type = type;
+            event.user.windowID = SDL_GetWindowID(data->window);
+            event.user.code = code;
+            SDL_PushEvent(&event);
+            if (code == MENUNULL || !item)
+                break;
+            code = item->NextSelect;
+        }
+        return;
+    }
     if (data->win) {
         if (data->menu) {
             struct MenuItem *item = ItemAddress(data->menu, m->Code);
@@ -690,6 +711,19 @@
     switch (m->Class) {
     case IDCMP_MENUPICK:
         AROS_HandleMenu(_this, m);
+        break;
+
+    case IDCMP_MENUVERIFY:
+        /* Let the program bring its menu up to date before it shows; the
+           message is replied to after this returns. The callback may change
+           item flags but must not replace the strip. */
+        if (m->Code == MENUHOT && data && data->win && data->win->MenuStrip != data->menu) {
+            SDL_PropertiesID props = SDL_GetWindowProperties(data->window);
+            void (*cb)(void *, struct Window *) = (void (*)(void *, struct Window *))
+                SDL_GetPointerProperty(props, SDL_PROP_WINDOW_AROS_MENUVERIFY_CALLBACK_POINTER, NULL);
+            if (cb)
+                cb(SDL_GetPointerProperty(props, SDL_PROP_WINDOW_AROS_MENUVERIFY_USERDATA_POINTER, NULL), data->win);
+        }
         break;
 
     case IDCMP_REFRESHWINDOW:
