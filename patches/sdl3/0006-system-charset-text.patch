Title: Convert text between UTF-8 and the system character set
Repository: SDL 3.4.12 with contrib SDL3-3.4.12-aros.diff (contrib 142b3ff4)
Date: 2026-11-16
Author: aros-sdl project
Problem: AROS_ConvertUTF8Text turned every non-ASCII character into '?', so window titles, message boxes and FTXT clipboard text lost national characters (e.g. "zażółć" became "za????"); AROS_ConvertTextUTF8 copied system-charset bytes unchanged, so CHRS clipboard text was invalid UTF-8; dropped file names were passed to SDL in the system character set.
Change: Both helpers convert with SDL_iconv between UTF-8 and the system character set (ENV:CHARSET, ISO-8859-1 without it); a character the set lacks becomes '?'. Drop events convert the path to UTF-8. AROS_SystemCharset (patch 0003) is shared through SDL_arosmisc.h.
Scope: AROS (src/video/aros)
Upstream: https://github.com/aros-development-team/contrib/pull/93 (open, submitted 2026-11-16)
Verification: mainline x86_64, pool v1-1, 2026-11-16, ENV:CHARSET ISO-8859-2: LibreSprite window title for "zażółć.png" carries the Latin-2 bytes (shown as "za¿ó³æ.png" by the Latin-1 system font). Clipboard text and drop paths not yet tested.
Contrib branch: tomaszstaniak/contrib sdl3-system-charset-text 8f461898 (on sdl3-text-input), on contrib master 142b3ff4; built in-tree and checked before/after 2026-11-16 (tests/aros/sdl3-contrib-check.c); PR not opened yet
Removal: when contrib converts these strings
---
diff -ru a/src/video/aros/SDL_arosevents.c b/src/video/aros/SDL_arosevents.c
--- a/src/video/aros/SDL_arosevents.c	2026-11-16 16:30:04
+++ b/src/video/aros/SDL_arosevents.c	2026-11-16 16:30:04
@@ -35,6 +35,7 @@
 #include "SDL_aroswindow.h"
 #include "SDL_arosopengl.h"
 #include "SDL_arosmouse.h"
+#include "SDL_arosmisc.h"
 
 #include <devices/inputevent.h>
 #include <devices/rawkeycodes.h>
@@ -135,7 +136,7 @@
 /* The system character set: keymaps produce bytes in the set the Locale
    preferences store in ENV:CHARSET (codesets.library names, e.g.
    "ISO-8859-2"; "ISO-8859-1 + Euro" is the codesets default). */
-static const char *
+const char *
 AROS_SystemCharset(void)
 {
 	static char charset[64];
@@ -853,7 +854,12 @@
 							AddPart(filename, argptr->wa_Name, 1024);
 
 							D(bug("[SDL3:arosevt] %s: SDL_SendDropfile : '%s'\n", __func__, filename));
-							SDL_SendDropFile(window, NULL, filename);
+							{
+								/* SDL drop events carry UTF-8 */
+								char *utf8 = AROS_ConvertTextUTF8(filename);
+								SDL_SendDropFile(window, NULL, utf8 ? utf8 : filename);
+								SDL_free(utf8);
+							}
 							argptr++;
 						}
 					}
diff -ru a/src/video/aros/SDL_arosmisc.c b/src/video/aros/SDL_arosmisc.c
--- a/src/video/aros/SDL_arosmisc.c	2026-11-16 16:30:04
+++ b/src/video/aros/SDL_arosmisc.c	2026-11-16 16:30:04
@@ -28,56 +28,81 @@
 #endif
 #include <sys/types.h>
 
-// Convert UTF-8 to ISO-8859-1
+/* Length of the UTF-8 sequence starting at src (1 for a stray byte), not
+   past the terminating NUL. */
+static size_t AROS_UTF8SequenceLength(const char *src)
+{
+    unsigned char c = (unsigned char)*src;
+    size_t n = (c < 0x80) ? 1 : ((c & 0xE0) == 0xC0) ? 2 : ((c & 0xF0) == 0xE0) ? 3 : ((c & 0xF8) == 0xF0) ? 4 : 1;
+    for (size_t i = 1; i < n; i++) {
+        if (((unsigned char)src[i] & 0xC0) != 0x80)
+            return i;
+    }
+    return n;
+}
+
+// Convert UTF-8 to the system character set
 char *AROS_ConvertUTF8Text(const char *src)
 {
     if (!src)
         return NULL;
 
-    // Worst-case: every byte becomes one ASCII char + null terminator
-    size_t len = 0;
-    const char *p = src;
-    while (*p)
-        len++, p++;
-
+    // The system character set never needs more bytes than UTF-8.
+    size_t len = SDL_strlen(src);
     char *dst = SDL_malloc(len + 1);
     if (!dst)
         return NULL;
 
+    SDL_iconv_t cd = SDL_iconv_open(AROS_SystemCharset(), "UTF-8");
     size_t out = 0;
     while (*src) {
-        unsigned char c = (unsigned char)*src;
-        if (c < 0x80) {
+        size_t n = AROS_UTF8SequenceLength(src);
+        if ((unsigned char)*src < 0x80) {
             dst[out++] = *src++;
-        } else {
-            if ((c & 0xE0) == 0xC0)
-                src += 2;
-            else if ((c & 0xF0) == 0xE0)
-                src += 3;
-            else if ((c & 0xF8) == 0xF0)
-                src += 4;
-            else
-                src++;
-            dst[out++] = '?';
+            continue;
         }
+        if (cd != (SDL_iconv_t)-1) {
+            const char *in = src;
+            size_t inleft = n;
+            char buf[8];
+            char *o = buf;
+            size_t oleft = sizeof(buf);
+            size_t r = SDL_iconv(cd, &in, &inleft, &o, &oleft);
+            size_t got = (size_t)(o - buf);
+            if (r < SDL_ICONV_EINVAL && inleft == 0 && got > 0 && got <= n) {
+                SDL_memcpy(dst + out, buf, got);
+                out += got;
+                src += n;
+                continue;
+            }
+            SDL_iconv(cd, NULL, NULL, NULL, NULL);
+        }
+        // not in the system character set
+        dst[out++] = '?';
+        src += n;
     }
+    if (cd != (SDL_iconv_t)-1)
+        SDL_iconv_close(cd);
 
     dst[out] = '\0';
     return dst;
 }
 
-// Convert ISO-8859-1 to UTF-8
+// Convert the system character set to UTF-8
 char *AROS_ConvertTextUTF8(const char *src)
 {
     if (!src)
         return NULL;
 
     size_t len = SDL_strlen(src);
-    char *dst = SDL_malloc(len + 1);
+    char *dst = SDL_iconv_string("UTF-8", AROS_SystemCharset(), src, len + 1);
     if (!dst)
-        return NULL;
-
-    SDL_memcpy(dst, src, len + 1);
+        dst = SDL_iconv_string("UTF-8", "ISO-8859-1", src, len + 1);
+    if (!dst) {
+        dst = SDL_malloc(len + 1);
+        if (dst)
+            SDL_memcpy(dst, src, len + 1);
+    }
     return dst;
 }
 
diff -ru a/src/video/aros/SDL_arosmisc.h b/src/video/aros/SDL_arosmisc.h
--- a/src/video/aros/SDL_arosmisc.h	2026-11-16 16:30:04
+++ b/src/video/aros/SDL_arosmisc.h	2026-11-16 16:30:04
@@ -26,7 +26,11 @@
 #include <exec/types.h>
 #endif
 
+/* The system character set (ENV:CHARSET), "ISO-8859-1" without one. */
+extern const char *AROS_SystemCharset(void);
+/* UTF-8 to the system character set; characters it lacks become '?'. */
 extern char *AROS_ConvertUTF8Text(const char *src);
+/* The system character set to UTF-8. */
 extern char *AROS_ConvertTextUTF8(const char *src);
 extern char *AROS_ConvertPath(const char *fn);
 
