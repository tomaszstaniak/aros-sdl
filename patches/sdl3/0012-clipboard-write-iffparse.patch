--- a/src/video/aros/SDL_arosclipboard.c	2026-11-20 14:13:18
+++ b/src/video/aros/SDL_arosclipboard.c	2026-11-20 14:13:18
@@ -39,161 +39,60 @@
 #define ID_CHRS	MAKE_ID('C','H','R','S')
 #define ID_UTF8	MAKE_ID('U','T','F','8')
 
-STATIC APTR clipboard_open(void)
+/* The text goes to the clipboard as FORM FTXT with a CHRS chunk in the system
+   character set, which every program reads, and a UTF8 chunk with the
+   unconverted text, which AROS_GetClipboardText prefers. iffparse.library
+   writes the chunk headers, so sizes are big-endian on every processor. */
+bool
+AROS_SetClipboardText(SDL_VideoDevice *_this, const char *text)
 {
-	struct IOClipReq *io;
-	struct MsgPort *mp;
+	struct IFFHandle *clip;
+	char *stext;
+	bool ok = false;
 
-	mp = CreateMsgPort();
+	if (!text)
+		text = "";
 
-	if ((io = (struct IOClipReq *)CreateIORequest(mp,sizeof(struct IOClipReq)))) {
-		if (!(OpenDevice("clipboard.device", 0, (struct IORequest *)io, 0))) {
-			return io;
-		}
+	stext = AROS_ConvertUTF8Text(text);
+	if (!stext)
+		return SDL_OutOfMemory();
 
-		DeleteIORequest((struct IORequest *)io);
-	}
+	if ((clip = AllocIFF())) {
+		clip->iff_Stream = (IPTR)OpenClipboard(0);
 
-	DeleteMsgPort(mp);
-	return NULL;
-}
+		if (clip->iff_Stream) {
+			InitIFFasClip(clip);
 
-STATIC ULONG clipboard_write_data(struct IOClipReq *io, CONST_APTR data, ULONG len)
-{
-	LONG rc;
+			if (!OpenIFF(clip, IFFF_WRITE)) {
+				LONG slen = (LONG)SDL_strlen(stext);
+				LONG ulen = (LONG)SDL_strlen(text);
 
-	io->io_Command = CMD_WRITE;
-	io->io_Data    = (APTR)data;
-	io->io_Length  = len;
-	DoIO( (struct IORequest *)io);
+				if (!PushChunk(clip, ID_FTXT, ID_FORM, IFFSIZE_UNKNOWN)
+				 && !PushChunk(clip, 0, ID_CHRS, IFFSIZE_UNKNOWN)
+				 && WriteChunkBytes(clip, stext, slen) == slen
+				 && !PopChunk(clip)
+				 && !PushChunk(clip, 0, ID_UTF8, IFFSIZE_UNKNOWN)
+				 && WriteChunkBytes(clip, (APTR)text, ulen) == ulen
+				 && !PopChunk(clip)
+				 && !PopChunk(clip))
+					ok = true;
 
-	if (io->io_Actual != len) {
-		io->io_Error = 1;
-	}
+				CloseIFF(clip);
+			}
 
-	rc = io->io_Error ? FALSE : TRUE;
-	return rc;
-}
