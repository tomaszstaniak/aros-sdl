+/* On the Workbench screen the screen bar takes the top lines: windows are
+   kept below it (see AROS_SetWindowPosition). */
+bool
+AROS_GetDisplayUsableBounds(SDL_VideoDevice *_this, SDL_VideoDisplay * display, SDL_Rect * rect)
+{
+	SDL_VideoData *data = (SDL_VideoData *) _this->internal;
+
+	AROS_GetDisplayBounds(_this, display, rect);
+
+	if (data->CustomScreen == NULL && data->WScreen != NULL) {
+		int bar = data->WScreen->BarHeight + 1;
+
+		if (bar < rect->h) {
+			rect->y += bar;
+			rect->h -= bar;
+		}
+	}
+
+	return true;
+}
