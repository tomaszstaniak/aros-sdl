+/* Intuition applies ChangeWindowBox from its input handler and then sends
+   IDCMP_CHANGEWINDOW, one for every request. The last one reports the result
+   to SDL and ends the pending state. Wait for that, but not for long: a
+   window that takes no messages must not block the program. */
+bool
+AROS_SyncWindow(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	const Uint64 start = SDL_GetTicks();
+
+	if (!data->win)
+		return true;
+
+	while (data->box_requests > 0) {
+		AROS_PumpEvents(_this);
+
+		if (data->box_requests <= 0)
+			break;
+		if (SDL_GetTicks() - start > 500) {
+			data->box_requests = 0;
+			return false;
+		}
+
+		SDL_Delay(5);
 	}
 
 	return true;
