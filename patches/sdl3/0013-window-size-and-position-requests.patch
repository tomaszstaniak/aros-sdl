+
+/* SDL keeps a requested position and size in window->pending until the
+   backend reports them with a window event; window->x/y/w/h still hold the
+   old values when SetWindowPosition and SetWindowSize are called.
+   ChangeWindowBox is deferred as well, so the Intuition window may not show
+   an earlier request yet. This asks for the box made of what is pending and,
+   for the rest, of what the window has now. */
+static void
+AROS_ChangeToRequestedBox(SDL_Window *window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	SDL_VideoData *vd = data->videodata;
+	struct Screen *scr = data->win->WScreen;
+	LONG bar = (vd->CustomScreen == NULL) ? scr->BarHeight + 1 : 0;
+	LONG left = data->win->LeftEdge, top = data->win->TopEdge;
+	LONG width = data->win->Width, height = data->win->Height;
+
+	if (window->last_size_pending) {
+		width = window->pending.w;
+		height = window->pending.h;
+
+		if ((window->flags & SDL_WINDOW_BORDERLESS) == 0) {
+			width += data->win->BorderLeft + data->win->BorderRight;
+			height += data->win->BorderTop + data->win->BorderBottom;
+		}
+
+		width = MIN((LONG)scr->Width, width);
+		height = MIN((LONG)scr->Height - bar, height);
+	}
+
+	if (window->last_position_pending) {
+		left = window->pending.x;
+		top = window->pending.y;
+
+		/* A window that starts left of or above the screen cannot be
+		   dragged back: its title bar is out of reach. */
+		if (left + width > scr->Width)
+			left = scr->Width - width;
+		if (left < 0)
+			left = 0;
+		if (top + height > scr->Height)
+			top = scr->Height - height;
+		if (top < bar)
+			top = bar;
+	}
+
+	data->box_requests++;
+	ChangeWindowBox(data->win, left, top, width, height);
 }
 
