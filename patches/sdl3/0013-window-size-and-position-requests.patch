--- a/src/video/aros/SDL_arosevents.c	2026-11-20 17:02:43
+++ b/src/video/aros/SDL_arosevents.c	2026-11-20 17:09:06
@@ -321,13 +321,24 @@
 AROS_ChangeWindow(SDL_VideoDevice *_this, const struct IntuiMessage *m, SDL_WindowData *data)
 {
 	struct Window *w = data->win;
+	BOOL answered;
 
 	D(bug("[SDL3:arosevt] %s()\n", __func__));
 
+	/* Every ChangeWindowBox of ours is answered by one message. Until the
+	   last answer the window may still show an older request. */
+	if (data->box_requests > 0)
+		data->box_requests--;
+	answered = (data->box_requests == 0);
+
 	if (data->curr_x != w->LeftEdge || data->curr_y != w->TopEdge) {
 		data->curr_x = w->LeftEdge;
 		data->curr_y = w->TopEdge;
 		SDL_SendWindowEvent(data->window, SDL_EVENT_WINDOW_MOVED, data->curr_x, data->curr_y);
+	} else if (answered && data->window->last_position_pending) {
+		/* A requested position that left the window where it was: tell SDL
+		   the request is done (no event reaches the program). */
+		SDL_SendWindowEvent(data->window, SDL_EVENT_WINDOW_MOVED, data->curr_x, data->curr_y);
 	}
 
 	if (data->curr_w != w->Width || data->curr_h != w->Height) {
@@ -340,6 +351,8 @@
             AROS_GL_ResizeContext(_this, data->window);
         }
 #endif
+	} else if (answered && data->window->last_size_pending) {
+		SDL_SendWindowEvent(data->window, SDL_EVENT_WINDOW_RESIZED, (data->curr_w - w->BorderLeft - w->BorderRight), (data->curr_h - w->BorderTop - w->BorderBottom));
 	}
 }
 
