Title: Redraw the window frame after an OpenGL window shrinks
Repository: SDL 3.4.12 with contrib SDL3-3.4.12-aros.diff (contrib 142b3ff4)
Date: 2026-11-20
Author: aros-sdl project
Problem: After an OpenGL window became smaller, gl.library showed a buffer of the old size once more. That picture was drawn over the window's right and bottom borders and stayed there, because later buffers have the new size and Intuition had drawn the frame before.
Change: After a window shrank, the frame is drawn again (RefreshWindowFrame) after each of the next two buffer swaps.
Scope: AROS (src/video/aros)
Upstream: local-only (works around gl.library showing a stale buffer; mainline x86_64 nightly 2026-11-15, softpipe)
Verification: kits build for mainline x86_64, Raspberry Pi and x86_64 ABIv11. Mainline x86_64 (nightly 2026-11-15, softpipe), 2026-11-20, LOVE 12.0: before, after a window went from 780x565 to 640x360 its right and bottom borders showed parts of the old picture; after, the frame is whole. Not run: Raspberry Pi, ABIv11, a hardware OpenGL driver.
Removal: when gl.library no longer shows a buffer larger than the window
---
--- a/src/video/aros/SDL_arosevents.c	2026-11-20 17:16:22
+++ b/src/video/aros/SDL_arosevents.c	2026-11-20 17:16:22
@@ -342,6 +342,12 @@
 	}
 
 	if (data->curr_w != w->Width || data->curr_h != w->Height) {
+		/* gl.library shows a buffer of the old size once more after the
+		   window changed size; when the window shrank, that picture covers
+		   the right and bottom borders. Draw the frame again after the next
+		   buffer swaps (AROS_GL_SwapWindow). */
+		if (w->Width < data->curr_w || w->Height < data->curr_h)
+			data->frame_refresh = 2;
 		data->curr_w = w->Width;
 		data->curr_h = w->Height;
 		SDL_SendWindowEvent(data->window, SDL_EVENT_WINDOW_RESIZED, (data->curr_w - w->BorderLeft - w->BorderRight), (data->curr_h - w->BorderTop - w->BorderBottom));
--- a/src/video/aros/SDL_arosopengl.c	2026-11-20 17:16:22
+++ b/src/video/aros/SDL_arosopengl.c	2026-11-20 17:17:22
@@ -343,6 +343,8 @@
 		return true;
 
 	glASwapBuffers(_this->gl_data->gldd_GLACtx);
+
+	AROS_FrameAfterSwap(data);
 
 	return true;
 }
--- a/src/video/aros/SDL_aroswindow.c	2026-11-20 17:17:22
+++ b/src/video/aros/SDL_aroswindow.c	2026-11-20 17:20:48
@@ -367,7 +367,18 @@
 	return true;
 }
 
+/* Called after an OpenGL buffer swap: draws the frame again while a shrink
+   is recent (see AROS_ChangeWindow). */
 void
+AROS_FrameAfterSwap(SDL_WindowData *data)
+{
+	if (data->frame_refresh > 0 && data->win) {
+		data->frame_refresh--;
+		RefreshWindowFrame(data->win);
+	}
+}
+
+void
 AROS_SetWindowMinimumSize(SDL_VideoDevice *_this, SDL_Window * window)
 {
 	SDL_WindowData *data = (SDL_WindowData *) window->internal;
--- a/src/video/aros/SDL_aroswindow.h	2026-11-20 17:16:22
+++ b/src/video/aros/SDL_aroswindow.h	2026-11-20 17:17:22
@@ -77,6 +77,7 @@
 	// Currently known window position and dimensions
 	LONG curr_x, curr_y, curr_w, curr_h;
 	int box_requests;	/* ChangeWindowBox calls not yet answered by IDCMP_CHANGEWINDOW */
+	int frame_refresh;	/* buffer swaps after which the window frame is drawn again */
 	int old_w, old_h, old_x, old_y;
 
 	// Flags that must be taken into account at AROS_ShowWindow()
@@ -107,6 +108,7 @@
 extern bool AROS_SetWindowIcon(SDL_VideoDevice *_this, SDL_Window * window, SDL_Surface * icon);
 extern bool AROS_SetWindowPosition(SDL_VideoDevice *_this, SDL_Window * window);
 extern bool AROS_SyncWindow(SDL_VideoDevice *_this, SDL_Window * window);
+extern void AROS_FrameAfterSwap(SDL_WindowData *data);
 extern void AROS_SetWindowMinimumSize(SDL_VideoDevice *_this, SDL_Window * window);
 extern void AROS_SetWindowMaximumSize(SDL_VideoDevice *_this, SDL_Window * window);
 extern void AROS_SetWindowSize(SDL_VideoDevice *_this, SDL_Window * window);
